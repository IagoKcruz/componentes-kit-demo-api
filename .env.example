# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.
# ============================================================

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=agendamentos

# URL usada fora do Docker (localhost). Dentro do Docker o
# docker-compose monta a URL apontando para o serviço "db".
DATABASE_URL=postgresql+asyncpg://postgres:troque-esta-senha@localhost:5432/agendamentos

# --- Autenticação JWT ---
# false = todos os endpoints livres, true = exige Bearer token
AUTH_HABILITADO=true
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-esta-chave-secreta-longa-e-aleatoria
JWT_ALGORITMO=HS256
JWT_EXPIRACAO_MINUTOS=60

# --- App ---
DEBUG=false
# Origens permitidas no CORS. Use * apenas em dev.
# Em produção: CORS_ORIGINS=https://meusite.com,https://app.meusite.com
CORS_ORIGINS=*
